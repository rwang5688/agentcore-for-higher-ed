{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "AdmissionAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "AdmissionAgent"
  },
  "runtimes": [
    {
      "name": "AdmissionAgent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/AdmissionAgent/",
      "runtimeVersion": "PYTHON_3_13",
      "envVars": [
        {
          "name": "ADVISOR_MCP_URL",
          "value": "https://admissionagent-education-advisor-gateway-n3fuofcvdx.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp"
        },
        {
          "name": "ATHENA_LAMBDA_NAME",
          "value": "education-athena-query"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-west-2"
        },
        {
          "name": "KNOWLEDGE_BASE_ID",
          "value": "ONVQOQ7XJB"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "executionRoleArn": "arn:aws:iam::331773567763:role/agentcore-agent-role"
    }
  ],
  "memories": [
    {
      "name": "admission_agent_memory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "education-advisor-gateway",
      "protocolType": "None",
      "description": "Gateway for education-advisor-gateway",
      "targets": [
        {
          "name": "advisor-requests",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:331773567763:function:education-advisor-requests",
            "toolSchemaFile": "../mcp/tools.json"
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}