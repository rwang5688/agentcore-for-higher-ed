# Copy this file to .env and fill in the values.
# .env is git-ignored so real secrets never get committed.

# --- AWS ---
# Deployed AgentCore runtime ARN (from `agentcore status`). Used by the thin
# Streamlit client (streamlit_advisor.py) to call the deployed agent.
AGENTCORE_RUNTIME_ARN=your_agentcore_runtime_arn_here

# Name of the Lambda that runs Athena SQL against education_workshop_db.
ATHENA_LAMBDA_NAME=education-athena-query

# Region where your Bedrock models, Knowledge Base, and Lambda live.
AWS_REGION=us-west-2

# Bedrock model ID the agent uses.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Bedrock Knowledge Base ID (course catalog / handbooks).
KNOWLEDGE_BASE_ID=your_knowledge_base_id_here

# Authentication: choose ONE of the approaches below.
#
# Option A (recommended): use your normal AWS credentials via the AWS CLI/SSO,
# e.g. `aws configure` or `aws sso login`. Leave the key below unset.
#
# Option B (dev only): a short-lived Bedrock API key (expires in ~30 days).
# AWS_BEDROCK_API_KEY=your_bedrock_api_key_here
